# Public Supabase project configuration. These values are safe to expose to the
# browser; database access is still restricted by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only enable buttons for providers that are configured in Supabase and at the
# upstream provider. Email OTP is optional.
KNUFL_AUTH_GOOGLE_ENABLED=false
KNUFL_AUTH_APPLE_ENABLED=false
KNUFL_AUTH_EMAIL_OTP_ENABLED=false

# Worker-only secrets. Set through the hosting provider, never in this file or a
# NEXT_PUBLIC_* variable. After bearer validation, the API uses the service-role
# key for owner-filtered workout writes and the voice ledger. Browser profile,
# preferences and memory access still uses the signed-in user plus RLS.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Server-side Realtime limits. Keep these as ordinary non-secret environment
# values in preview and production.
KNUFL_REALTIME_MODEL=gpt-realtime-2.1
KNUFL_REALTIME_VOICE=marin
KNUFL_MAX_ACTIVE_REALTIME_SESSIONS=1
KNUFL_DAILY_REALTIME_MINUTES=60
KNUFL_MAX_REALTIME_SESSION_MINUTES=30
